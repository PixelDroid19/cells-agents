# Prompt before force-pushing outside the sandbox.
prefix_rule(
    pattern = ["git", "push", ["--force", "-f"]],
    decision = "prompt",
    justification = "Force pushing can discard history; confirm the exact target before continuing.",
    match = [
        "git push --force origin feature-branch",
        "git push -f origin main",
    ],
    not_match = [
        "git push origin feature-branch",
    ],
)

# Block destructive git resets outside the sandbox.
prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Use non-destructive inspection or explicit file edits instead of git reset --hard.",
    match = [
        "git reset --hard",
        "git reset --hard HEAD~1",
    ],
)

# Prompt before repository deletion patterns.
prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "prompt",
    justification = "Recursive deletions can remove workspace state; confirm the exact path before continuing.",
    match = [
        "rm -rf dist",
        "rm -rf /tmp/cells-artifacts",
    ],
    not_match = [
        "rm -f README.md",
    ],
)

# Prompt before generic Node test/start commands in Cells repositories.
# The Cells command policy requires resolving test and demo commands through cells-cli-usage first.
prefix_rule(
    pattern = ["npm", "test"],
    decision = "prompt",
    justification = "Cells projects should resolve test commands through cells-cli-usage before using generic npm test.",
    match = [
        "npm test",
        "npm test -- --watch",
    ],
)

prefix_rule(
    pattern = ["npm", "run", ["test", "start"]],
    decision = "prompt",
    justification = "Cells projects should resolve test/start commands through cells-cli-usage before using generic npm scripts.",
    match = [
        "npm run test",
        "npm run start",
    ],
)

prefix_rule(
    pattern = ["npx", "web-test-runner"],
    decision = "prompt",
    justification = "Cells projects should route browser test command selection through cells-cli-usage first.",
    match = [
        "npx web-test-runner",
    ],
)
