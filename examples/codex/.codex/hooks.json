{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/scripts/cells-session-context.js\"",
            "timeout": 10,
            "statusMessage": "Loading CELLS Codex context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/scripts/cells-pretool-policy.js\"",
            "timeout": 10,
            "statusMessage": "Checking CELLS command policy"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/scripts/cells-stop-reminder.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
